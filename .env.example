# minty-billing-api - local settings. Copy to .env; never commit .env.
#
# No inline comments after a value (`FOO=bar # note` sets FOO to "bar # note").

# ---------------------------------------------------------------------------
# The shared secret. Flask MINTS the JWTs this service verifies; a mismatch is not a boot
# failure, it is a 401 on every request. Same value as Minty, billing-backend and
# onboarding-backend. Outside DEBUG the placeholder refuses to boot.
# ---------------------------------------------------------------------------
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=*

# ---------------------------------------------------------------------------
# Database - the same database and schema Flask owns. This service never migrates.
# ---------------------------------------------------------------------------
POSTGRES_DB=minty_cleanse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# The schema, shared with Minty (default pettycashv3 - the permanent name).
MINTY_DB_SCHEMA=pettycashv3

# ---------------------------------------------------------------------------
# The two switches. Both OFF by default: production cut over dark, and a timer pointed at
# a database with real payers starts charging them within the hour.
#   SUBSCRIPTION_ENABLED=1            the feature (every route, the scheduler, the jobs)
#   SUBSCRIPTION_SCHEDULER_ENABLED=1  the in-process timer - the deployed web service only
# Switching SUBSCRIPTION_ENABLED on writes nothing; `manage.py subscriptions
# revoke-ungranted` is the separate launch-day command.
# ---------------------------------------------------------------------------
SUBSCRIPTION_ENABLED=0
SUBSCRIPTION_SCHEDULER_ENABLED=0
SUBSCRIPTION_SCHEDULER_LIGHT=1
SUBSCRIPTION_SCHEDULER_TZ=Asia/Hong_Kong
SUBSCRIPTION_SCHEDULER_FULL_HOUR=5

# ---------------------------------------------------------------------------
# Stripe - THIS SERVICE IS THE ONLY HOLDER (rule 9). Test-mode keys locally.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Mail - the subscription notices, on the same Brevo SMTP Minty uses. Without EMAIL_HOST
# every send is written to the console and skipped.
# ---------------------------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
SUBSCRIPTION_EMAIL=noreply@example.com
DEFAULT_FROM_EMAIL=noreply@example.com

# ---------------------------------------------------------------------------
# The other services. Browser origins for CORS; Flask for the one forwarded call
# (invite-admin) and the login-gated re-handoff links in emails.
# ---------------------------------------------------------------------------
FLASK_APP_URL=http://localhost:5001
FLASK_PROXY_TIMEOUT=20
MINTY_WEB_URL=http://localhost:3002
PAYMENTS_WEB_URL=http://localhost:3000
# Defaults to MINTY_WEB_URL,PAYMENTS_WEB_URL; set explicitly for a deployment.
# CORS_ALLOWED_ORIGINS=https://minty-web.example,https://payments.example

LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Tests (not read by the service). Unset -> SQLite, tables from the models. Set -> the
# Postgres build of Minty's docs/schema/01_schema_rebased.sql through Minty/tests/pg_harness.py.
# ---------------------------------------------------------------------------
# MINTY_TEST_PG_URI=postgresql://postgres:password@localhost:5432/postgres
# MINTY_REPO=C:\Github\Minty
