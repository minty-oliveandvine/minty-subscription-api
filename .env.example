# minty-subscription-api - local settings. Copy to .env; never commit .env.
#
# No inline comments after a value (`FOO=bar # note` sets FOO to "bar # note").

# ---------------------------------------------------------------------------
# development | production (the default; anything else is production). DEBUG follows it.
# ---------------------------------------------------------------------------
APP_ENV=development

# ---------------------------------------------------------------------------
# The shared secret. Flask MINTS the JWTs this service verifies; a mismatch is not a boot
# failure, it is a 401 on every request. Same value as Minty, minty-payment-request-api and
# minty-onboarding-api. Outside development the placeholder refuses to boot.
# ---------------------------------------------------------------------------
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=*

# ---------------------------------------------------------------------------
# Database - the same database and schema Flask owns. This service never migrates.
# ?schema= is the schema, shared with Minty (default pettycashv3 - the permanent name); every
# other query parameter (sslmode=require, ...) goes to the driver.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres?schema=pettycashv3

# ---------------------------------------------------------------------------
# Mail - the subscription notices, on the same Brevo SMTP Minty uses. Unset, every send is
# written to the console and skipped.
#   smtp://user:pass@host:587    STARTTLS          smtps://user:pass@host:465   implicit SSL
#   ?timeout=10 seconds per SMTP step (default 10); ?tls=0 for a local catcher (smtp:// only)
# Percent-encode reserved characters in the user and password (@ is %40).
# ---------------------------------------------------------------------------
SMTP_URL=
MAIL_FROM=noreply@example.com
# Optional per-purpose senders, both default to MAIL_FROM. The billing notices:
# SUBSCRIPTION_EMAIL=noreply@example.com
# The "finish setting up your company" reminder (production: onboarding@dailyminty.com,
# which the SMTP relay must accept as a sender):
# ONBOARDING_EMAIL=noreply@example.com

# ---------------------------------------------------------------------------
# Stripe - THIS SERVICE IS THE ONLY HOLDER (rule 9). Test-mode keys locally.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# The other services. Browser origins for CORS; Flask for the one forwarded call
# (invite-admin) and the login-gated re-handoff links in emails.
# ---------------------------------------------------------------------------
PETTY_CASH_URL=http://localhost:8010
# The address a PERSON reaches Minty at: every link in an email. Defaults to PETTY_CASH_URL;
# in the docker stack that is the internal name, so set it there.
# PETTY_CASH_PUBLIC_URL=http://localhost:8010
MINTY_WEB_URL=http://localhost:3000
PAYMENT_REQUEST_WEB_URL=http://localhost:3020
# Defaults to MINTY_WEB_URL,PAYMENT_REQUEST_WEB_URL,PETTY_CASH_PUBLIC_URL (Flask's pages show
# the sidebar's Subscriptions Overview); set explicitly for a deployment.
# CORS_ALLOWED_ORIGINS=https://minty-web.example,https://payments.example,https://minty.example

# ---------------------------------------------------------------------------
# The scheduler switch. Subscriptions are always on; the in-process timer is OFF by
# default, because a timer pointed at a database with real payers starts charging them
# within the hour.
#   SUBSCRIPTION_SCHEDULER_ENABLED=1  the in-process timer - the deployed web service only
# `manage.py subscriptions revoke-ungranted` is a separate, deliberate command.
# ---------------------------------------------------------------------------
SUBSCRIPTION_SCHEDULER_ENABLED=0
SUBSCRIPTION_SCHEDULER_LIGHT=1
SUBSCRIPTION_SCHEDULER_TZ=Asia/Hong_Kong
SUBSCRIPTION_SCHEDULER_FULL_HOUR=5

# LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Tests (not read by the service). Unset -> SQLite, tables from the models. Set -> the
# Postgres build of Minty's docs/schema/01_schema_rebased.sql through Minty/tests/pg_harness.py.
# ---------------------------------------------------------------------------
# MINTY_TEST_PG_URI=postgresql://postgres:password@localhost:5432/postgres
# MINTY_REPO=C:\Github\Minty
